import "ConstrainedBox/AspectRatio.idl";

namespace XamlToolkit.WinUI.Controls
{
	[webhosthidden]
	runtimeclass ConstrainedBox : Microsoft.UI.Xaml.Controls.ContentPresenter
    {
        ConstrainedBox();

		[noexcept]
		static Microsoft.UI.Xaml.DependencyProperty ScaleXProperty{ get; };
		Double ScaleX;

		[noexcept]
		static Microsoft.UI.Xaml.DependencyProperty ScaleYProperty{ get; };
		Double ScaleY;

		[noexcept]
		static Microsoft.UI.Xaml.DependencyProperty MultipleXProperty{ get; };
		Int32 MultipleX;

		[noexcept]
		static Microsoft.UI.Xaml.DependencyProperty MultipleYProperty{ get; };
		Int32 MultipleY;

		[noexcept]
		static Microsoft.UI.Xaml.DependencyProperty AspectRatioProperty{ get; };
		AspectRatio AspectRatio;
    }
}
