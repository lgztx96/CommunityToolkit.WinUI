import "Effects/Abstract/PipelineEffect.idl";

namespace XamlToolkit.WinUI.Media
{
    /// <summary>
    /// An effect that overlays a color layer over the current builder, with a specified intensity
    /// </summary>
    runtimeclass ShadeEffect : PipelineEffect
    {
        /// <summary>
        /// Initializes a new instance of the ShadeEffect class.
        /// </summary>
        ShadeEffect();

        /// <summary>
        /// Gets or sets the color to use
        /// </summary>
        [noexcept]
        Windows.UI.Color Color;

        /// <summary>
        /// Gets or sets the intensity of the color layer (default to 0.5, should be in the [0, 1] range)
        /// </summary>
        [noexcept]
        Double Intensity;
    };
}
