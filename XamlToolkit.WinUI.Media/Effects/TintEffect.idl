import "Effects/Abstract/PipelineEffect.idl";

namespace XamlToolkit.WinUI.Media
{
    /// <summary>
    /// A tint effect
    /// </summary>
    /// <remarks>This effect maps to the Win2D TintEffect effect</remarks>
    runtimeclass TintEffect : PipelineEffect
    {
        /// <summary>
        /// Initializes a new instance of the TintEffect class.
        /// </summary>
        TintEffect();

        /// <summary>
        /// Gets or sets the int color to use
        /// </summary>
        [noexcept]
        Windows.UI.Color Color;
    };
}
