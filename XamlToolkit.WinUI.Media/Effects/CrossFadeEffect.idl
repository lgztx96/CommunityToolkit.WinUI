import "Effects/Abstract/PipelineEffect.idl";
import "Pipelines/PipelineBuilder.idl";

namespace XamlToolkit.WinUI.Media
{
    /// <summary>
    /// A blend effect that merges the current builder with an input one
    /// </summary>
    /// <remarks>This effect maps to the Win2D CrossFadeEffect effect</remarks>
    [webhosthidden]
    [contentproperty("Effects")]
    runtimeclass CrossFadeEffect : PipelineEffect
    {
        /// <summary>
        /// Initializes a new instance of the CrossFadeEffect class.
        /// </summary>
        CrossFadeEffect();

        [noexcept]
	    XamlToolkit.WinUI.Media.Pipelines.PipelineBuilder Source;

        Windows.Foundation.Collections.IVector<IPipelineEffect> Effects;

        /// <summary>
        /// Gets or sets the The cross fade factor to blend the input effects (default to 0.5, should be in the [0, 1] range)
        /// </summary>
        [noexcept]
        Double Factor;
    };
}
