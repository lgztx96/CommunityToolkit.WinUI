import "Effects/Abstract/PipelineEffect.idl";

namespace XamlToolkit.WinUI.Media
{
    /// <summary>
    /// An color inversion effect
    /// </summary>
    /// <remarks>This effect maps to the Win2D InvertEffect effect</remarks>
    [webhosthidden]
    [default_interface]
    runtimeclass InvertEffect : PipelineEffect
    {
        /// <summary>
        /// Initializes a new instance of the InvertEffect class.
        /// </summary>
        InvertEffect();
    };
}
