import "Effects/Abstract/PipelineEffect.idl";

namespace XamlToolkit.WinUI.Media
{
    /// <summary>
    /// A hue rotation effect
    /// </summary>
    /// <remarks>This effect maps to the Win2D HueRotationEffect effect</remarks>
    runtimeclass HueRotationEffect : PipelineEffect
    {
        /// <summary>
        /// Initializes a new instance of the HueRotationEffect class.
        /// </summary>
        HueRotationEffect();

        /// <summary>
        /// Gets or sets the angle to rotate the hue, in radians
        /// </summary>
        Double Angle;
    };
}