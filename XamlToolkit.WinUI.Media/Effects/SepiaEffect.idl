import "Effects/Abstract/PipelineEffect.idl";

namespace XamlToolkit.WinUI.Media
{
    /// <summary>
    /// A sepia effect
    /// </summary>
    /// <remarks>This effect maps to the Win2D SepiaEffect effect</remarks>
    runtimeclass SepiaEffect : PipelineEffect
    {
        /// <summary>
        /// Initializes a new instance of the SepiaEffect class.
        /// </summary>
        SepiaEffect();

        /// <summary>
        /// Gets or sets the intensity of the effect (defaults to 0.5, should be in the [0, 1] range).
        /// </summary>
        Double Intensity;
    };
}