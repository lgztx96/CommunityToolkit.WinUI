import "Effects/Abstract/ImageSourceBaseExtension.idl";

namespace XamlToolkit.WinUI.Media
{
    /// <summary>
    /// An effect that loads an image and replicates it to cover all the available surface area
    /// </summary>
    /// <remarks>This effect maps to the Win2D BorderEffect effect</remarks>
    [default_interface]
    runtimeclass TileSourceExtension : ImageSourceBaseExtension
    {
        /// <summary>
        /// Initializes a new instance of the TileSourceExtension class.
        /// </summary>
        TileSourceExtension();
    };
}