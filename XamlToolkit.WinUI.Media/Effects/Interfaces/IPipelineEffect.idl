import "Pipelines/PipelineBuilder.idl";

namespace XamlToolkit.WinUI.Media
{
    /// <summary>
    /// The base interface for all the builder effects to be used in a CompositionBrush.
    /// </summary>
    interface IPipelineEffect
    {
        /// <summary>
        /// Gets the current CompositionBrush instance, if one is in use.
        /// </summary>
        Microsoft.UI.Composition.CompositionBrush Brush{ get; };

        /// <summary>
        /// Appends the current effect to the input <see cref="PipelineBuilder"/> instance.
        /// </summary>
        /// <param name="builder">The source <see cref="PipelineBuilder"/> instance to add the effect to.</param>
        /// <returns>A new <see cref="PipelineBuilder"/> with the new effects added to it.</returns>
        XamlToolkit.WinUI.Media.Pipelines.PipelineBuilder AppendToBuilder(XamlToolkit.WinUI.Media.Pipelines.PipelineBuilder builder);

        /// <summary>
        /// Notifies that a given CompositionBrush is now in use.
        /// </summary>
        /// <param name="brush">The CompositionBrush in use.</param>
        void NotifyCompositionBrushInUse(Microsoft.UI.Composition.CompositionBrush brush);
    };
}
