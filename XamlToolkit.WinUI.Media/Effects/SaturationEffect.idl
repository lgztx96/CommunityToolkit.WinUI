import "Effects/Abstract/PipelineEffect.idl";

namespace XamlToolkit.WinUI.Media
{
    /// <summary>
    /// A saturation effect
    /// </summary>
    /// <remarks>This effect maps to the Win2D SaturationEffect effect</remarks>
    [webhosthidden]
    runtimeclass SaturationEffect : PipelineEffect
    {
        /// <summary>
        /// Initializes a new instance of the SaturationEffect class.
        /// </summary>
        SaturationEffect();

        /// <summary>
        /// Gets or sets the saturation amount to apply to the background (defaults to 1, should be in the [0, 1] range).
        /// </summary>
        [noexcept]
        Double Value;
    };
}
