import "Effects/Abstract/PipelineEffect.idl";

namespace XamlToolkit.WinUI.Media
{
    /// <summary>
    /// A gaussian blur effect
    /// </summary>
    /// <remarks>This effect maps to the Win2D GaussianBlurEffect effect</remarks>
    runtimeclass BlurEffect : PipelineEffect
    {
        /// <summary>
        /// Initializes a new instance of the BlurEffect class.
        /// </summary>
        BlurEffect();

        /// <summary>
        /// Gets or sets the blur amount for the effect (must be a positive value)
        /// </summary>
        [noexcept]
        Double Amount;
    };
}
