import "Visuals/AttachedVisualFactoryBase.idl";
import "Pipelines/PipelineBuilder.idl";

namespace XamlToolkit.WinUI.Media
{
    /// <summary>
    /// A base class that extends <see cref="AttachedVisualFactoryBase"/> by leveraging the <see cref="PipelineBuilder"/> APIs.
    /// </summary>
    unsealed runtimeclass PipelineVisualFactoryBase : AttachedVisualFactoryBase
    {
        /// <summary>
        /// Initializes a new instance of the <see cref="PipelineVisualFactoryBase"/> class.
        /// </summary>
        PipelineVisualFactoryBase();

        overridable XamlToolkit.WinUI.Media.Pipelines.PipelineBuilder OnPipelineRequested();
    };
}
