import "DoubleToObjectConverter.idl";

namespace XamlToolkit.WinUI.Converters
{
    /// <summary>
    /// This class converts a double value into a Visibility enumeration.
    /// </summary>
    [default_interface]
    runtimeclass DoubleToVisibilityConverter : XamlToolkit.WinUI.Converters.DoubleToObjectConverter
    {
        DoubleToVisibilityConverter();
    }
}