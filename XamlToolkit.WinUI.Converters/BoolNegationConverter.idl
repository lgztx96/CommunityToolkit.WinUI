namespace XamlToolkit.WinUI.Converters
{
    /// <summary>
    /// Value converter that applies NOT operator to a bool value.
    /// </summary>
    [webhosthidden]
    [default_interface]
    runtimeclass BoolNegationConverter : Microsoft.UI.Xaml.Data.IValueConverter
    {
        BoolNegationConverter();
    }
}
