import "EmptyObjectToObjectConverter.idl";

namespace XamlToolkit.WinUI.Converters
{
    /// <summary>
    /// This class converts a string value into a an object (if the value is null or empty returns the false value).
    /// Can be used to bind a visibility, a color or an image to the value of a string.
    /// </summary>
    [default_interface]
    unsealed runtimeclass EmptyStringToObjectConverter : XamlToolkit.WinUI.Converters.EmptyObjectToObjectConverter
    {
        EmptyStringToObjectConverter();
    }
}
