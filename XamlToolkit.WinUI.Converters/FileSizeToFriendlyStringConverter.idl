namespace XamlToolkit.WinUI.Converters
{
    /// <summary>
    /// Converts a file size in bytes to a more human-readable friendly format.
    /// </summary>
    [webhosthidden]
    [default_interface]
    runtimeclass FileSizeToFriendlyStringConverter : Microsoft.UI.Xaml.Data.IValueConverter
    {
        FileSizeToFriendlyStringConverter();
    }
}
