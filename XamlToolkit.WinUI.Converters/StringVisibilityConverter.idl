import "EmptyStringToObjectConverter.idl";

namespace XamlToolkit.WinUI.Converters
{
    /// <summary>
    /// This class converts a string value into a Visibility value (if the value is null or empty returns a collapsed value).
    /// </summary>
    [default_interface]
    runtimeclass StringVisibilityConverter : XamlToolkit.WinUI.Converters.EmptyStringToObjectConverter
    {
        StringVisibilityConverter();
    }
}
