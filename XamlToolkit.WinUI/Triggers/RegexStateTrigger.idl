namespace XamlToolkit.WinUI
{
    enum RegexOptions
    {
        None,
        IgnoreCase,
        Multiline,
        Optimize
    };

    runtimeclass RegexStateTrigger : Microsoft.UI.Xaml.StateTriggerBase
    {
        RegexStateTrigger();

        String Value;
        static Microsoft.UI.Xaml.DependencyProperty ValueProperty{ get; };

        String Expression;
        static Microsoft.UI.Xaml.DependencyProperty ExpressionProperty{ get; };

        RegexOptions Options;
        static Microsoft.UI.Xaml.DependencyProperty OptionsProperty{ get; };
    }
}
