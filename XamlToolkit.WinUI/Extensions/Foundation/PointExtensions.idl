namespace XamlToolkit.WinUI
{
    [webhosthidden]
    static runtimeclass PointExtensions
    {
        [noexcept]
        static Windows.Foundation.Rect ToRect(Windows.Foundation.Point point, Double width, Double height);

        [noexcept]
        [default_overload]
        static Windows.Foundation.Rect ToRect(Windows.Foundation.Point point, Windows.Foundation.Point end);
        
        [noexcept]
        static Windows.Foundation.Rect ToRect(Windows.Foundation.Point point, Windows.Foundation.Size size);

        [noexcept]
        static Windows.Foundation.Numerics.Vector3 ToVector3(Windows.Foundation.Point point);
    }
}
